{
  "name": "openfile",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-bridge.mjs",
    "e2e:mcp": "node scripts/e2e-mcp.mjs",
    "e2e:acp": "node scripts/e2e-acp.mjs",
    "e2e:pack": "node scripts/e2e-pack.mjs",
    "mcp": "node scripts/openfile-mcp.mjs",
    "typecheck": "tsc --noEmit",
    "lint:deps": "knip --no-progress && dpdm --no-warning --no-tree -T --skip-dynamic-imports circular --exit-code circular:1 src/main.tsx packages/runtime/src/cli.ts scripts/dev-runtime.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@handlewithcare/prosemirror-suggest-changes": "^0.1.8",
    "@openfile/protocol": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "codemirror": "^6.0.2",
    "diff": "^9.0.0",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.14",
    "katex": "^0.18.4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-decode-string": "^2.0.1",
    "pdfjs-dist": "^6.4.299",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "dpdm": "^3.15.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "knip": "^5.88.1",
    "remark-breaks": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  },
  "description": "Openfile — the document UI for CLI agents",
  "license": "Apache-2.0"
}
