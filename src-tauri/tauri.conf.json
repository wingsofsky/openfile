{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openfile",
  "version": "0.1.0",
  "identifier": "com.wingsofsky.openfile",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Openfile",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval' 'sha256-BEz+IrhLzn+Gss2l3Eg29LoCbSIiCs+FkKEfGC6v19w='; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "resources": ["resources/openfile-cli/**/*"],
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "windows": {
      "nsis": { "installerHooks": "./windows/hooks.nsh" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
